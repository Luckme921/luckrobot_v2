__pycache__/
*.pyc
*.pyo

# IDE 配置
.vscode/
.idea/

# 系统临时文件
.DS_Store
Thumbs.db

# 压缩包/安装包
*.zip
*.tar.gz
*.deb

# 奥比中光SDK模型描述文件（体积大，无需版本管理）
src/OrbbecSDK_ROS2/orbbec_description/

# 编译中间文件及库文件（必须加星号匹配版本号）
*.so
*.so.*
*.a
*.o
*.swp

# 忽略奥比中光全部 SDK 库文件（这些千万别传，体积巨大）
src/OrbbecSDK_ROS2/orbbec_camera/SDK/lib/