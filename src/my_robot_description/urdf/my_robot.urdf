<?xml version="1.0" encoding="utf-8"?>
<!-- 工业级 AMR 机器人核心描述文件 -->
<!-- 终极优化版：全局采用纯数学几何体(无任何 STL 模型)，极致压榨性能，彻底解决 SSH 下的 RViz 卡顿 -->
<robot name="my_awesome_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ======================================================== -->
  <!-- 1. 定义物理中心与地面投影 -->
  <!-- ======================================================== -->
  <!-- 虚拟的地面正投影点，供 Nav2 和 AMCL 定位使用 -->
  <link name="base_footprint"/>

  <!-- 精确校准：底盘中心 (base_link) 距离地面高度为 13.5mm (0.0135m) -->
  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 0.0135" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <!-- ======================================================== -->
  <!-- 2. 小车主体 base_link (直径350mm, 高120mm 的圆柱体) -->
  <!-- ======================================================== -->
  <link name="base_link">
    <visual>
      <!-- Z轴抬高 0.06m (120mm的一半)，使得圆柱体底部正好落在 0 的位置 -->
      <origin xyz="0 0 0.06" rpy="0 0 0" />
      <geometry>
        <!-- 半径 175mm (0.175m)，高度 120mm (0.12m) -->
        <cylinder radius="0.175" length="0.12" />
      </geometry>
      <material name="white">
        <!-- 设为浅灰色，方便在 RViz 中观察 -->
        <color rgba="0.8 0.8 0.8 1" />
      </material>
    </visual>
    <!-- 碰撞体积与外观完全一致，Nav2 算力开销降到最低 -->
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.175" length="0.12" />
      </geometry>
    </collision>
  </link>

  <!-- ======================================================== -->
  <!-- 3. 相机物理外壳与螺纹孔 (倒装, 极简长方体优化) -->
  <!-- ======================================================== -->
  <link name="camera_color_screw_frame">
    <!-- 外观与碰撞均使用真实尺寸的长方体 (27.7mm x 124mm x 29mm) -->
    <visual>
      <origin xyz="0 0 0.0145" rpy="0 0 0" />
      <geometry>
        <box size="0.0277 0.124 0.029" />
      </geometry>
      <material name="dark_gray">
        <color rgba="0.3 0.3 0.3 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.0145" rpy="0 0 0" />
      <geometry>
        <box size="0.0277 0.124 0.029" />
      </geometry>
    </collision>
  </link>

  <joint name="camera_color_screw_joint" type="fixed">
    <!-- 2026-09-12：203 mm 升高夹具安装后，用12组棋盘/墙平面数据标定。
         棋盘正面到墙面补偿为 3.0 mm 板厚 + 3.5 mm 胶层/间隙。 -->
    <origin xyz="0.146327 -0.002217 0.342200" rpy="3.138477 -0.004836 -0.043870" />
    <parent link="base_link" />
    <child link="camera_color_screw_frame" />
  </joint>

  <!-- ======================================================== -->
  <!-- 🌟 4. 终极桥接魔法：连接物理螺丝孔与相机光学驱动源头 -->
  <!-- ======================================================== -->
  <link name="camera_link"/>

  <joint name="screw_to_camera_link_joint" type="fixed">
    <origin xyz="0.011715 0.0475 0.014311" rpy="0 0 0" />
    <parent link="camera_color_screw_frame" />
    <child link="camera_link" />
  </joint>

  <!-- ======================================================== -->
  <!-- 5. 激光雷达 A2M12 (倒装, 极简圆柱体优化) -->
  <!-- ======================================================== -->
  <link name="laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.038" length="0.041" />
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.038" length="0.041" />
      </geometry>
    </collision>
  </link>

  <joint name="laser_joint" type="fixed">
    <!-- 将 Z 轴旋转 180 度修正模型误差 -->
    <origin xyz="0 0 0.096" rpy="3.1416 0 0" />
    <parent link="base_link" />
    <child link="laser" />
  </joint>

  <!-- ======================================================== -->
  <!-- 6. IMU 模块 (倒装, 长8cm宽5cm高3cm的长方体盒子) -->
  <!-- ======================================================== -->
  <link name="imu_link">
    <visual>
      <!-- 长方体中心对齐 joint，无需偏移 -->
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.08 0.05 0.03" />
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.5 0.8 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.08 0.05 0.03" />
      </geometry>
    </collision>
  </link>

  <joint name="imu_joint" type="fixed">
    <!-- SW 导出的倒装姿态等效 -->
    <origin xyz="0 0 0.139" rpy="-3.1416 0 3.1371" />
    <parent link="base_link" />
    <child link="imu_link" />
  </joint>

</robot>
